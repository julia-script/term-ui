{
  "name": "@term-ui/root",
  "dependencies": {
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=./packages/* --filter=!@term-ui/docs --filter=!@termui/devtools",
    "dev": "turbo run dev --filter=./packages/* --filter=!@term-ui/docs --filter=!@termui/devtools",
    "dev:docs": "turbo run dev --filter=./packages/docs",
    "lint": "biome check",
    "lint:fix": "biome check --unsafe --write",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish",
    "cleanup": "turbo run cleanup",
    "check:clean-room": "./scripts/clean-room.sh",
    "test": "vitest run",
    "check": "pnpm build && pnpm test"
  },
  "type": "module",
  "packageManager": "pnpm@11.15.1"
}
