{
  "name": "@term-ui/core",
  "type": "module",
  "version": "0.0.1",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./constants": {
      "import": "./dist/constants.js",
      "types": "./dist/constants.d.ts"
    },
    "./core.wasm": "./dist/core.wasm",
    "./core-debug.wasm": "./dist/core-debug.wasm"
  },
  "scripts": {
    "cleanup": "rm -rf dist zig-out .zig-cache",
    "build:wasm:debug": "zig build wasm",
    "build:wasm:release": "zig build wasm --release=safe",
    "build:wasm:all": "pnpm build:wasm:debug && pnpm build:wasm:release",
    "build:ts": "tsc -p tsconfig.build.json",
    "postbuild:wasm:all": "cp zig-out/bin/core-debug.wasm dist/core-debug.wasm && wasm-opt -Oz --strip-dwarf -o dist/core.wasm zig-out/bin/core.wasm",
    "build": "rm -rf dist && mkdir -p dist && pnpm build:wasm:all && pnpm build:ts",
    "test": "vitest run .",
    "predev": "pnpm build:wasm:all",
    "dev": "pnpm dev:wasm & pnpm dev:ts",
    "dev:wasm": "watchexec -e zig -- pnpm build:wasm:all",
    "dev:ts": "tsc --watch --preserveWatchOutput -p tsconfig.build.json"
  },
  "devDependencies": {
    "@term-ui/shared": "workspace:*",
    "@types/chrome-remote-interface": "^0.31.14",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "chrome-remote-interface": "^0.33.3",
    "lodash-es": "catalog:",
    "ts-dedent": "catalog:",
    "valibot": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md"]
}
