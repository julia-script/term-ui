Legend:
  Token types: T = Text, SP = Space, LB = LineBreak
  Break types: × = NoBreak, ÷ = BreakAllowed, ! = MandatoryBreak
  Characters: _ = Space, \t = Tab
  White-space: collapse

Input: N1{ T["hello"]× SP["_"]÷ T["world"]×}
Output: N1{ T["hello"]× SP["_"]÷ T["world"]×}