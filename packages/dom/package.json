{
  "name": "@term-ui/dom",
  "version": "0.0.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "default": "./dist/devtools/index.js"
    }
  },
  "type": "module",
  "keywords": [
    "terminal",
    "tui",
    "dom",
    "ui",
    "cli",
